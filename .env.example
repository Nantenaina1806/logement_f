# Ampiasaina amin'ny "docker compose up" - adikao ho .env ity fichier ity
# ary ovay ny valeur amin'ny production.

DB_USER=postgres
DB_PASSWORD=changez_moi
DB_NAME=logement_location_vente
JWT_SECRET=changez_moi_avec_une_valeur_longue_et_aleatoire

