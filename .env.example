# efa mihary amin'ny domaine tena izy (fa tsy localhost intsony).
VITE_API_URL=http://localhost:5000/api
VITE_SERVER_URL=http://localhost:5000
VITE_FACEBOOK_URL=https://facebook.com/logementmad.fianarantsoa
